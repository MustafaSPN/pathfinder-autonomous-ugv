# NTRIP / RTK correction settings for this vehicle.
#
#   cp ntrip.env.example ntrip.env
#   # fill in NTRIP_HOST / NTRIP_USERNAME / NTRIP_PASSWORD
#   set -a && . ./ntrip.env && set +a
#   ros2 launch rover_bringup rover.launch.py
#
# ntrip.env is git-ignored. Never commit real credentials.
#
# Host of the NTRIP caster you have an account with.
NTRIP_HOST=
# Caster port and mountpoint used by this vehicle (a national network-RTK service (VRS)).
# These are not secrets and are kept here so the vehicle's behaviour is reproducible.
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=VRSRTCM34
# Account credentials issued by your correction-service provider.
NTRIP_USERNAME=
NTRIP_PASSWORD=
